workflows:
  android-release:
    name: "SLM Play Android Release"
    environment:
      java: 17
      vars:
        PACKAGE_NAME: "com.slm.play"
    scripts:
      - name: "Check Java and Gradle"
        script: |
          java -version
          chmod +x ./gradlew
          ./gradlew --version
      - name: "Clean project"
        script: |
          ./gradlew clean
      - name: "Build release APK"
        script: |
          ./gradlew assembleRelease
    artifacts:
      - "app/build/outputs/apk/release/*.apk"
      - "app/build/outputs/mapping/release/mapping.txt"
    publishing:
      email:
        recipients:
          - "$CM_NOTIFY_EMAIL"
        notify:
          success: true
          failure: true

  android-debug:
    name: "SLM Play Debug APK"
    environment:
      java: 17
    scripts:
      - name: "Prepare Gradle"
        script: |
          chmod +x ./gradlew
          ./gradlew --version
      - name: "Build debug APK"
        script: |
          ./gradlew assembleDebug
    artifacts:
      - "app/build/outputs/apk/debug/*.apk"
    scripts:
      - name: Prepare Gradle
        script: |
          chmod +x ./gradlew
          ./gradlew --version
      - name: Build debug APK
        script: |
          ./gradlew assembleDebug
    artifacts:
      - app/build/outputs/apk/debug/*.apk
